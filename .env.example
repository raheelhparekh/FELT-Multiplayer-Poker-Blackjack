# ─────────────────────────────────────────────────────────────
# Felt Blackjack — Environment Configuration
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- Database ---
# Postgres connection string. If left blank or commented out, the server
# automatically falls back to an in-memory database store for local dev and testing.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/felt

# --- Authentication ---
# Secret key used for signing JWT auth tokens and httpOnly cookies.
JWT_SECRET=super-secret-random-key-change-in-production

# --- Server Networking ---
PORT=3001
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# --- Pacing & Animation Beats ---
# Set to false to disable artificial dealing beats in automated test suites
PACING_ENABLED=true

# --- Production & Assets ---
# NODE_ENV=development
# STATIC_DIR=apps/web/dist
