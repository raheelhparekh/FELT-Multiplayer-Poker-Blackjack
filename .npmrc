# Pre-approve build scripts for known safe native packages.
# This avoids the interactive `pnpm approve-builds` prompt in CI and dev.
approve-builds=true

# Explicitly list packages allowed to run postinstall scripts
onlyBuiltDependencies[]=@biomejs/biome
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=better-sqlite3
onlyBuiltDependencies[]=argon2
