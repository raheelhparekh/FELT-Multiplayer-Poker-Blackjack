{
  "name": "felt",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter '@felt/shared' build && pnpm --filter '@felt/server' build && pnpm --filter '@felt/web' build",
    "test": "pnpm --filter @felt/shared test && pnpm --filter @felt/server test",
    "test:ci": "pnpm --filter @felt/shared test --reporter=verbose && pnpm --filter @felt/server test --reporter=verbose",
    "load-test": "pnpm --filter @felt/tools load-test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm --recursive typecheck",
    "clean": "pnpm --recursive exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.2"
  }
}
